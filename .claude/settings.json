{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Bash(:*)",
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Workflow",
      "Monitor",
      "ToolSearch",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "SendMessage",
      "ReadNotifications",
      "ScheduleWakeup",
      "mcp__github",
      "mcp__github__*",
      "mcp__claude-code-remote",
      "mcp__claude-code-remote__*",
      "mcp__Claude_Docs",
      "mcp__Claude_Docs__*",
      "mcp__ccd_session",
      "mcp__ccd_session__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "sessionUrl": false,
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "GIT_AUTHOR_NAME": "Azathothas",
    "GIT_AUTHOR_EMAIL": "ajamx101@gmail.com",
    "GIT_COMMITTER_NAME": "Azathothas",
    "GIT_COMMITTER_EMAIL": "ajamx101@gmail.com"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/session-start.sh"
          }
        ]
      }
    ]
  }
}
